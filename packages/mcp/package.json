{
  "name": "@wellworn/mcp",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "tsup": "^8.5.1",
    "tsx": "^4",
    "typescript": "^7",
    "vitest": "^3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wellworn/db": "workspace:*",
    "@wellworn/ratelimit": "workspace:*",
    "@wellworn/verdict": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^5",
    "pg": "^8.23.0",
    "semver": "^7.8.5",
    "zod": "^3.25.76"
  },
  "description": "The Wellworn MCP server: verdicts, traps, skills, and design answers for coding agents over Streamable HTTP. Self-host it with Postgres and Redis, or use https://mcp.wellworn.dev/mcp.",
  "license": "MIT",
  "bin": {
    "wellworn-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WellWorn-dev/wellworn.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://wellworn.dev/docs/security/self-hosting",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agents",
    "dependencies"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
